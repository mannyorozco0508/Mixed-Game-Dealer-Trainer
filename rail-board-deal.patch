+  // Pitch them one at a time. Each card is inserted into the DOM only at the
+  // moment it lands — nothing is pre-rendered, so seats genuinely grow from
+  // empty and no card ever occupies layout space before it arrives.
+  const generation = dealGeneration;
+  // For big deals, tighten the gap so a 7-handed 7-card street stays brisk.
