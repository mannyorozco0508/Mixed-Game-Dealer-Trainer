+  const potEl = document.getElementById('potDisplay');
+  if(potEl){
+    const total = view ? view.pot
+      : moneyState.pot + moneyState.seats.reduce((n,s) => n + moneyState.streetContrib[s], 0);
+    potEl.innerHTML = total > 0
+      ? (window.RailChips ? window.RailChips.renderPot(total) : 'POT $' + total)
