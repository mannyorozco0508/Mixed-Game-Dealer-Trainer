+    <div class="player-panel">
+      <div class="player-status ${isFold ? 'folded' : 'allin'}">${isFold ? 'FOLDED' : 'ALL-IN'}</div>
+      <div class="player-help">${isFold
+        ? 'Your hand is dead for this pot. The hand plays on \u2014 watch how the dealer runs it out.'
+        : 'You have no chips left to bet, but your hand is still live for every pot you funded.'}</div>
+      <div class="watch-note">WATCH REST OF HAND</div>
+      ${coach ? '<div class="dealer-coach"><span class="coach-tag">DEALER COACH</span>' + coach + '</div>' : ''}
+    </div>`;
+}
+
+function clearHumanControls(){
+  const qa = document.getElementById('qaColumn');
+  if(qa && qa.querySelector('.player-panel')) qa.innerHTML = '';
+}
+
+function submitHumanAction(seat, opt){
+  if(!window.RailPlayer) return;
+  // Re-validate against live state: a stale tap can never mutate the hand.
+  if(!window.RailPlayer.isLegalHumanAction(currentRound, moneyState, seat, activeStepIndex,
+      opt.action, { action: window.RailAction, money: window.RailMoney })) return;
+
+  currentRound = window.RailAction.applyAction(currentRound, seat, opt.action);
+  let amount = 0;
+  if(window.RailMoney && moneyState){
+    amount = window.RailMoney.applyMoneyAction(moneyState, seat, opt.action, activeStepIndex);
+  }
+  if(opt.action === 'fold'){
+    foldedSeats.add(seat);
+    markSeatFolded(seat);
+    playerSession.folded = true;
+    playerSession.watching = true;   // the hand plays on; keep watching
+  }
+  const nowAllIn = moneyState && moneyState.allIn[seat];
+  clearHumanControls();
+  showSeatAction(seat, opt.action, amount, nowAllIn);
+  refreshMoneyUI();
+  if(playerSession.folded) showSpectatorPanel('folded');
+  else if(nowAllIn) showSpectatorPanel('allin');
