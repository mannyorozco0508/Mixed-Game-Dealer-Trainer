+// using the same round-robin dealing order and real measured travel
+// distances as before. Cards already on the table are never re-rendered.
+function updateTableView(stepIndex){
+  const pokerTable = document.getElementById('pokerTable');
+  if(!pokerTable) return;
+  const pattern = currentScenario && currentScenario.dealCat ? DEAL_PATTERNS[currentScenario.dealCat] : null;
+  if(!pattern){
