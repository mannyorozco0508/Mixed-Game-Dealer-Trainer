+/* ---------------- Dealer error presentation ----------------
+   These functions change ONLY what the trainee sees. Authoritative deal
+   order, current actor, card identity, stacks, contributions and pots are
+   never written to — the fault is undone by restoring presentation. */
+
+// Builds the context the error registry needs, entirely from live state.
+function faultContext(){
+  const pattern = currentScenario && DEAL_PATTERNS[currentScenario.dealCat];
+  const hasBoard = !!(pattern && Math.max.apply(null, pattern.board) > 0);
+  const active = [];
+  for(let i = 0; i < tableSeats; i++){
+    if(i !== sitOutSeatIndex && !foldedSeats.has(i)) active.push(i);
+  }
+  return {
+    street: activeStepIndex,
+    hasBoard: hasBoard,
+    actionOpen: !!(currentRound && !currentRound.complete),
+    currentActor: currentRound ? currentRound.current : null,
+    // Expected recipient comes from the SAME action-order logic the
+    // simulation uses — this layer never computes its own seat order.
+    expectedRecipient: () => {
+      if(!window.RailAction || !currentScenario) return null;
+      return window.RailAction.firstActor({
+        dealCat: currentScenario.dealCat,
+        tableSeats: tableSeats,
+        buttonSeat: buttonSeatIndex,
+        sitOutSeat: sitOutSeatIndex,
+        foldedSeats: foldedSeats,
+        street: activeStepIndex,
+        upCards: upCardsBySeat(),
+        highBringsIn: currentScenario.name.indexOf('Stud Hi-Lo') !== 0
+      });
+    },
+    pickSeat: exclude => {
+      const pool = active.filter(s => s !== exclude);
+      return pool.length ? pool[Math.floor(Math.random() * pool.length)] : null;
+    }
+  };
+}
+
+// Applies the visual fault and records exactly what to undo.
+function presentFault(fault){
+  if(!fault) return;
+  activeFault = fault;
+  faultVisualState = { type: fault.errorType };
+  cancelPendingActions();  // freeze the table so the situation cannot change
+  flushPendingDeals();
+
+  if(fault.errorType === 'exposed-card'){
+    const el = seatEls[fault.affectedSeat];
+    const container = el && el.querySelector('.seat-cards');
+    const cardEl = container && container.children[fault.affectedCardIndex];
+    if(cardEl && cardEl.classList.contains('face-down')){
+      const slot = (seatSlotMaps[fault.affectedSeat] || [])[fault.affectedCardIndex];
+      const card = (seatHoleCards[fault.affectedSeat] || [])[slot];
+      if(card){
+        // Presentation only: the card's identity and slot are untouched.
+        faultVisualState.restore = { seat: fault.affectedSeat, index: fault.affectedCardIndex };
+        cardEl.classList.remove('face-down');
+        cardEl.classList.add('fault-exposed');
+        cardEl.textContent = cardFaceText(card);
+        if(cardIsRed(card)) cardEl.classList.add('red');
+      }
+    }
+  } else if(fault.errorType === 'wrong-recipient'){
+    const el = seatEls[fault.presentedRecipient];
+    if(el){ el.classList.add('fault-highlight'); faultVisualState.restore = { seat: fault.presentedRecipient }; }
+  } else if(fault.errorType === 'action-out-of-turn'){
+    // Show a badge on the offending seat WITHOUT touching currentRound.
+    showSeatAction(fault.offendingSeat, 'bet', 0, false);
+    const el = seatEls[fault.offendingSeat];
+    if(el){ el.classList.add('fault-highlight'); faultVisualState.restore = { seat: fault.offendingSeat, badge: true }; }
+  } else if(fault.errorType === 'premature-board'){
+    // Add ONE extra board card visually. It is drawn from the already-dealt
+    // board array, so no new card identity is created.
+    const boardEl = document.getElementById('boardRow1');
+    const nextCard = tableBoardCards[boardEl ? boardEl.children.length : 0];
+    if(boardEl && nextCard){
+      boardEl.insertAdjacentHTML('beforeend', cardHtml(nextCard, false, 0, 0, 40));
+      const added = boardEl.lastElementChild;
+      added.classList.add('fault-exposed');
+      faultVisualState.restore = { boardEl: true };
+    }
+  }
+}
+
+// Undoes the visual fault and restores a coherent table.
+function clearActiveFault(){
+  if(faultVisualState){
+    const r = faultVisualState.restore;
+    if(faultVisualState.type === 'exposed-card' && r){
+      const el = seatEls[r.seat];
+      const container = el && el.querySelector('.seat-cards');
+      const cardEl = container && container.children[r.index];
+      if(cardEl){
+        cardEl.classList.add('face-down');
+        cardEl.classList.remove('red', 'fault-exposed');
+        cardEl.textContent = '';
+      }
+    } else if(faultVisualState.type === 'premature-board' && r && r.boardEl){
+      const boardEl = document.getElementById('boardRow1');
+      if(boardEl && boardEl.lastElementChild) boardEl.lastElementChild.remove();
+    } else if(r && r.seat !== undefined){
+      const el = seatEls[r.seat];
+      if(el){
+        el.classList.remove('fault-highlight');
+        if(r.badge){
+          const badge = el.querySelector('.action-badge');
+          if(badge) badge.remove();
+        }
+      }
+    }
+  }
+  seatEls.forEach(el => el && el.classList.remove('fault-highlight'));
+  activeFault = null;
+  faultVisualState = null;
+}
+
+/* ---------------- Dynamic dealer task rendering ---------------- */
+
+// Makes the actual player seats the answer interface. No duplicate row of
+// seat buttons under the table — the table IS the input.
+function renderSelectSeatTask(step, optionList){
+  optionList.innerHTML = '<div class="task-hint">Tap the player on the table.</div>';
+  for(let i = 0; i < tableSeats; i++){
+    if(i === sitOutSeatIndex) continue;
+    const el = seatEls[i];
+    if(!el) continue;
+    el.classList.add('seat-selectable');
+    el.setAttribute('role', 'button');
+    el.setAttribute('tabindex', '0');
+    el.setAttribute('aria-label', 'Select Player ' + (i + 1));
+    const submit = () => submitSeatAnswer(step, i, optionList);
+    el._taskHandler = submit;
+    el.addEventListener('click', submit);
+    el.addEventListener('keydown', function(e){
+      if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); submit(); }
+    });
+  }
+}
+
+// Multi-seat selection: tapping toggles, Submit validates the whole set.
+function renderSelectSeatsTask(step, optionList){
+  const chosen = new Set();
+  optionList.innerHTML = `
+    <div class="task-hint">Tap every eligible player, then Submit.</div>
+    <button class="numeric-submit" id="seatsSubmit">Submit</button>`;
+
+  for(let i = 0; i < tableSeats; i++){
+    if(i === sitOutSeatIndex) continue;
+    const el = seatEls[i];
+    if(!el) continue;
+    el.classList.add('seat-selectable');
+    el.setAttribute('role', 'checkbox');
+    el.setAttribute('aria-checked', 'false');
+    el.setAttribute('tabindex', '0');
+    el.setAttribute('aria-label', 'Player ' + (i + 1));
+    const toggle = () => {
+      if(taskAnswered) return;
+      if(chosen.has(i)){ chosen.delete(i); el.classList.remove('seat-chosen'); el.setAttribute('aria-checked','false'); }
+      else { chosen.add(i); el.classList.add('seat-chosen'); el.setAttribute('aria-checked','true'); }
+    };
+    el._taskHandler = toggle;
+    el.addEventListener('click', toggle);
+    el.addEventListener('keydown', function(e){
+      if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); toggle(); }
+    });
+  }
+
+  document.getElementById('seatsSubmit').addEventListener('click', () => {
+    if(taskAnswered) return;
+    taskAnswered = true;
+    const result = window.RailTasks.validateDealerTask(step, Array.from(chosen), activeTaskSnapshot);
+    (result.expected || []).forEach(s => { if(seatEls[s]) seatEls[s].classList.add('seat-correct'); });
+    (result.extraSeats || []).forEach(s => { if(seatEls[s]) seatEls[s].classList.add('seat-wrong'); });
+    finishTaskAnswer(result, optionList);
+  });
+}
+
+function submitSeatAnswer(step, seat, optionList){
+  if(taskAnswered) return;   // block double submission
+  taskAnswered = true;
+  const result = window.RailTasks.validateDealerTask(step, seat, activeTaskSnapshot);
+  if(seatEls[seat]) seatEls[seat].classList.add(result.correct ? 'seat-correct' : 'seat-wrong');
+  if(!result.correct && seatEls[result.expected]) seatEls[result.expected].classList.add('seat-correct');
+  finishTaskAnswer(result, optionList);
+}
+
+// Compact amount entry. Uses a real number input so hardware keyboards and
+// assistive tech work, with quick-tap chips for common amounts on mobile.
+function renderNumericTask(step, optionList){
+  optionList.innerHTML = `
+    <div class="task-hint">Enter the amount.</div>
+    <div class="numeric-entry">
+      <span class="numeric-prefix">$</span>
+      <input type="number" inputmode="numeric" step="1" min="0" id="taskAmount"
+             class="numeric-input" aria-label="Amount in dollars">
+      <button class="numeric-submit" id="taskSubmit">Submit</button>
+    </div>`;
+  const input = document.getElementById('taskAmount');
+  const submit = () => {
+    if(taskAnswered) return;
+    taskAnswered = true;
+    const result = window.RailTasks.validateDealerTask(step, input.value, activeTaskSnapshot);
+    finishTaskAnswer(result, optionList);
+  };
+  document.getElementById('taskSubmit').addEventListener('click', submit);
+  input.addEventListener('keydown', function(e){ if(e.key === 'Enter') submit(); });
+  input.focus();
+}
+
+// Dynamic tasks feed the SAME scoring and review pipeline as legacy questions.
+function finishTaskAnswer(result, optionList){
+  if(result.correct){
+    if(!reviewMode) correctCount++;
+    playCorrectSound();
+  } else {
+    if(!reviewMode){
+      missedSteps.push(activeStepIndex);
+      taskReviewRecords.push(result.reviewRecord);
+    }
+    playIncorrectSound();
+  }
+
+  const feedbackBox = document.getElementById('feedbackBox');
+  const feedbackLabel = document.getElementById('feedbackLabel');
+  const feedbackText = document.getElementById('feedbackText');
+  feedbackBox.className = 'feedback-box show ' + (result.correct ? 'correct' : 'incorrect');
+  feedbackLabel.textContent = result.correct ? 'Correct' : 'Not quite';
+  const shaped = window.RailModes ? window.RailModes.presentFeedback(currentMode, result) : result.feedback;
+  feedbackText.textContent = shaped ||
+    (result.correct ? '' : 'The correct answer was ' + result.reviewRecord.expectedLabel + '.');
+
+  const advance = () => {
+    clearTaskInteraction();
+    clearActiveFault();   // restore a coherent table before the hand continues
+    if(reviewMode){ reviewPos++; } else { stepIndex++; }
+    renderStep();
+    if(!reviewMode && currentScenario && stepIndex < currentScenario.scenario.length){
+      startActionRound();
+    }
+  };
+  if(result.correct){
+    setTimeout(advance, 900);
+  } else {
+    const btn = document.getElementById('continueHandBtn');
+    if(btn){ btn.classList.add('show'); btn.onclick = advance; }
+  }
+}
+
+// Removes every trace of a task's interaction state so nothing leaks into
+// the next street or hand.
+function clearTaskInteraction(){
+  seatEls.forEach(el => {
+    if(!el) return;
+    el.classList.remove('seat-selectable', 'seat-correct', 'seat-wrong', 'seat-chosen');
+    el.removeAttribute('aria-checked');
+    el.removeAttribute('role');
+    el.removeAttribute('tabindex');
+    el.removeAttribute('aria-label');
+    if(el._taskHandler){
+      el.removeEventListener('click', el._taskHandler);
+      el._taskHandler = null;
+    }
+  });
+  activeTaskSnapshot = null;
+}
+
+function handleAnswer(opt, optionList){
+  const buttons = optionList.querySelectorAll('.option-btn');
+  buttons.forEach(b => b.disabled = true);
+
+  buttons.forEach(b => {
+    if(b.textContent === opt.text){
+      b.classList.add(opt.correct ? 'correct' : 'incorrect');
+    }
+  });
+  if(!opt.correct){
+    const correctOpt = currentScenario.scenario[activeStepIndex].options.find(o => o.correct);
+    buttons.forEach(b => {
+      if(b.textContent === correctOpt.text) b.classList.add('correct');
+    });
+    if(!reviewMode) missedSteps.push(activeStepIndex);
+    playIncorrectSound();
+  } else {
+    if(!reviewMode) correctCount++;
+    playCorrectSound();
+  }
+
+  const feedbackBox = document.getElementById('feedbackBox');
+  const feedbackLabel = document.getElementById('feedbackLabel');
+  const feedbackText = document.getElementById('feedbackText');
+  feedbackBox.className = 'feedback-box show ' + (opt.correct ? 'correct' : 'incorrect');
+  feedbackLabel.textContent = opt.correct ? 'Correct' : 'Not quite';
+  feedbackText.textContent = opt.feedback;
+
+  const advance = () => {
+    if(reviewMode){ reviewPos++; } else { stepIndex++; }
+    renderStep();
+    // Players act after the dealer's decision resolves, before the next
+    // street. Skipped in review mode (no live table there).
+    if(!reviewMode && currentScenario && stepIndex < currentScenario.scenario.length){
+      startActionRound();
+    }
+  };
+
+  if(opt.correct){
+    // Correct call — brief confirmation, then the hand just continues on
+    // its own, the way a real dealer's next street just happens.
+    setTimeout(advance, 900);
+  } else {
+    // Wrong call — the trainee needs to actually read why before moving on,
+    // so this requires a tap rather than auto-advancing past a mistake.
+    const continueBtn = document.getElementById('continueHandBtn');
+    continueBtn.classList.add('show');
+    continueBtn.onclick = advance;
+  }
+}
+
+// Compact showdown recap for the Hand Complete screen. Purely informational —
+// it never affects the dealer-decision scoring above it.
+// Concise financial result. Deliberately not a bankroll dashboard.
+function moneySummaryHtml(){
+  if(!moneyState) return '';
+  const seats = moneyState.seats;
+  if(!seats.length) return '';
+  const lines = seats.slice(0, 4).map(s => {
+    const start = moneyState.startingStacks[s];
+    const end = moneyState.stacks[s];
+    const diff = end - start;
+    const sign = diff > 0 ? '+' : '';
+    return 'Player ' + (s+1) + ': $' + end + ' (' + sign + diff + ')';
+  });
+  return `<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--slate-400);margin-top:10px;line-height:1.7;">
+    <div style="letter-spacing:0.1em;">CHIPS</div>
+    ${lines.map(l => `<div>${l}</div>`).join('')}
+  </div>`;
+}
+
+function showdownSummaryHtml(){
+  if(!showdownResult || !showdownResult.ok) return '';
+  const lines = showdownResult.sides.map(side => {
+    if(side.winners.length === 0) return `${side.label} \u2014 none qualified`;
+    return `${side.label} \u2014 ` + side.winners.map(s => 'Player ' + (s + 1)).join(' & ');
+  });
+  return `<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--brass-300);margin-top:10px;line-height:1.7;">
+    <div style="color:var(--slate-400);letter-spacing:0.1em;">SHOWDOWN</div>
+    ${lines.map(l => `<div>${l}</div>`).join('')}
+  </div>`;
+}
+
+function renderSummary(shouldRecord){
+  progressFill.style.width = '100%';
+  const steps = currentScenario.scenario;
+  const pct = Math.round((correctCount / steps.length) * 100);
+  const accuracy = Math.round((correctCount / steps.length) * 100);
+  let msg;
+  if(pct === 100) msg = "Clean hand, start to finish. That's exactly how it should run on the floor.";
+  else if(pct >= 70) msg = "Solid work. Review the streets you missed and this one'll be automatic.";
+  else msg = "That's why we practice. Run it back and lock in the sequence.";
+
+  const hud = document.getElementById('dealerHud');
+  if(hud) hud.innerHTML = `<span class="hud-game">${currentScenario.name}</span><span class="hud-sep">\u00b7</span><span class="hud-task">Hand Complete</span>`;
+  showDealerCue('Push Pot');
+
+  // Note: the table itself is intentionally left exactly as the last street
+  // rendered it — the hand just finished, so nothing should redeal or reset
+  // until the trainee explicitly asks for another hand.
+  const qaColumn = document.getElementById('qaColumn');
+  qaColumn.innerHTML = `
+    <div class="summary-wrap">
+      <div class="summary-label">Hand Complete</div>
+      <div class="summary-score">${correctCount}/${steps.length}</div>
+      <div class="summary-label">Dealer Decisions Correct</div>
+      <div style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:var(--slate-400);margin-top:8px;">
+        Correct: ${correctCount} &nbsp;\u00b7&nbsp; Mistakes: ${steps.length - correctCount} &nbsp;\u00b7&nbsp; Accuracy: ${accuracy}%
+      </div>
+      ${showdownSummaryHtml()}
+      ${moneySummaryHtml()}
+      <div class="summary-msg">${msg}</div>
+      <div class="summary-actions">
+        <button class="summary-btn" id="dealAgainBtn">Deal Another Hand</button>
+        <button class="summary-btn ghost" id="exitToShellBtn">Back to Games</button>
+      </div>
+      ${missedSteps.length > 0 ? `<button class="review-btn" id="reviewMissesBtn">Review ${missedSteps.length} Mistake${missedSteps.length > 1 ? 's' : ''}</button>` : ''}
+    </div>
+  `;
+  if(shouldRecord) recordAttempt(currentScenario.name, correctCount, steps.length);
+
+  document.getElementById('dealAgainBtn').addEventListener('click', () => {
+    stepIndex = 0;
+    correctCount = 0;
+    missedSteps = [];
+    reviewMode = false;
+    buildTable(currentScenario, true); // new shuffle, button rotates, cosmetic chips regenerate
+    renderHandShell(); // a genuinely new hand gets a fresh table, not a patched-up old one
+    renderStep();
+  });
+  document.getElementById('exitToShellBtn').addEventListener('click', closeScenario);
+  const reviewBtn = document.getElementById('reviewMissesBtn');
+  if(reviewBtn){
+    reviewBtn.addEventListener('click', () => {
+      reviewQueue = [...missedSteps];
+      reviewPos = 0;
+      reviewMode = true;
+      renderStep();
+    });
+  }
+}
+
+function closeScenario(){
+  cancelPendingDeals(); // no stale pitches into a closed or next table
+  overlay.classList.remove('open');
+  document.body.style.overflow = '';
+}
+document.getElementById('scenarioExit').addEventListener('click', closeScenario);
+
+/* ---------------- Engine Test Sandbox ---------------- */
+// Both the app and the engine now speak the same card model, so this reuses
+// the canonical presentation helper rather than keeping its own suit mapping.
+function handLabel(cards){ return cards.map(cardFaceText).join(' '); }
+
+document.getElementById('engineTestBtn').addEventListener('click', () => {
+  const out = document.getElementById('engineTestOutput');
+  const lines = [];
+
+  const deck = window.RailCards.freshDeck();
+  const hand5 = deck.splice(0, 5);
+
+  // Standard high (as used by Hold'em / Omaha / Stud)
+  const highScore = window.RailCards.evaluate5High(hand5);
+  const highTier = window.RailAI.classifyHigh(highScore);
+  const highTierName = ['WEAK','MARGINAL','STRONG','PREMIUM'][highTier];
+  const highAction = window.RailAI.decideAction({ tier: highTier, facingBet: true, facingRaise: false, canCheck: false });
+  lines.push('STANDARD HIGH  (Hold\u2019em / Omaha / Stud)');
+  lines.push('  Hand: ' + handLabel(hand5));
+  lines.push('  Category score: [' + highScore.join(', ') + ']');
+  lines.push('  AI reads this as: ' + highTierName + '  ->  facing a bet, AI would: ' + highAction.toUpperCase());
+  lines.push('');
+
+  // A-5 low (Badugi's cousin / Big O's low side)
+  const a5Score = window.RailCards.bestLowA5FromN(hand5).score;
+  const a5Tier = window.RailAI.classifyA5Low(a5Score);
+  const a5TierName = ['WEAK','MARGINAL','STRONG','PREMIUM'][a5Tier];
+  const qualifies = window.RailCards.qualifiesEightLow(a5Score);
+  lines.push('A-5 LOW  (same 5 cards)');
+  lines.push('  Best low reading: [' + a5Score.join(', ') + ']  |  8-or-better qualifier: ' + (qualifies ? 'YES' : 'no'));
+  lines.push('  AI reads this as: ' + a5TierName);
+  lines.push('');
+
+  // 2-7 low (same 5 cards, different lens)
+  const low27 = window.RailCards.bestLow27FromN(hand5);
+  const low27Tier = window.RailAI.classify27Low(low27.score);
+  const low27TierName = ['WEAK','MARGINAL','STRONG','PREMIUM'][low27Tier];
+  lines.push('2-7 LOW  (same 5 cards)');
+  lines.push('  AI reads this as: ' + low27TierName);
+  lines.push('');
+
+  // Badugi on a fresh 4-card deal
+  const hand4 = deck.splice(0, 4);
+  const badugi = window.RailCards.bestBadugi(hand4);
+  const badugiTier = window.RailAI.classifyBadugi(badugi);
+  const badugiTierName = ['WEAK','MARGINAL','STRONG','PREMIUM'][badugiTier];
+  lines.push('BADUGI  (fresh 4-card hand)');
+  lines.push('  Hand: ' + handLabel(hand4));
+  lines.push('  Best badugi found: ' + handLabel(badugi.cards) + '  (' + badugi.size + '-card)');
+  lines.push('  AI reads this as: ' + badugiTierName);
+  lines.push('');
+
+  // Pot-limit math sanity check
+  const maxRaise = window.RailBetting.potLimitMaxRaise(120, 20);
+  lines.push('POT-LIMIT CHECK: pot $120, facing a $20 call -> max raise $' + maxRaise + ' (should always be $140)');
+
+  out.textContent = lines.join('\n');
+});
+</script>
+
+</body>
+</html>
