+    APP.setSession(mods.RailPlayer.createPlayerSession({ dealCat: game.dealCat, tableSeats: 7 }));
+  } else {
+    APP.setSession(null);
+  }
+  APP.buildTable(game, false);
+  if(mode === 'play'){
+    const s = APP.playerSession;
