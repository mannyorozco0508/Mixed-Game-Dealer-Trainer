+  const game = currentScenario;
+  const highBringsIn = game.name.indexOf('Stud Hi-Lo') !== 0; // Hi-Lo: low brings in
+  currentRound = window.RailAction.createRound({
+    dealCat: game.dealCat,
+    tableSeats: tableSeats,
+    buttonSeat: buttonSeatIndex,
+    sitOutSeat: sitOutSeatIndex,
+    foldedSeats: foldedSeats,
+    street: activeStepIndex,
+    upCards: upCardsBySeat(),
+    highBringsIn: highBringsIn
+  });
