+// card is up". Presentation only — card identity is never touched, and cards
+// are never reordered to group face-up cards together.
+function applyFlipState(stepIndex){
+  const pattern = currentScenario && DEAL_PATTERNS[currentScenario.dealCat];
+  if(!pattern) return;
+  const clamped = Math.min(stepIndex, pattern.hole.length - 1);
+  const faceSeq = (pattern.faceSeq && pattern.faceSeq[clamped]) || '';
+  for(let i = 0; i < tableSeats; i++){
+    if(sitOutSeatIndex === i) continue;
+    const container = seatEls[i] && seatEls[i].querySelector('.seat-cards');
+    if(!container) continue;
+    const seatCards = seatHoleCards[i] || [];
+    const slotMap = seatSlotMaps[i] || [];
+    Array.from(container.children).forEach((el, pos) => {
+      const shouldBeUp = faceSeq.charAt(pos) === 'U';
+      const isUp = !el.classList.contains('face-down');
+      const card = seatCards[slotMap[pos]];
+      if(shouldBeUp && !isUp && card){
+        el.classList.remove('face-down');
+        el.textContent = cardFaceText(card);
+        if(cardIsRed(card)) el.classList.add('red');
+      } else if(!shouldBeUp && isUp){
+        el.classList.add('face-down');
+        el.classList.remove('red');
+        el.textContent = '';
+      }
+    });
+  }
