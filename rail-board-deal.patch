+    window.RailMoney.returnUncalledBet(moneyState, foldedSeats);
+    window.RailMoney.closeStreet(moneyState);
+    refreshMoneyUI();
+  }
+}
+
+// Updates every seat's stack label and the pot total from authoritative state.
+function refreshMoneyUI(){
