+  // that's exactly when a real burn happens (never on the very first deal,
+  // never on a pure discard). Approximate but honest: one pile-card per
+  // street-with-new-cards, not tracked with full per-street precision.
+  const isFreshDeal = (prevHoleCount + prevBoardCount + prevBoard2Count) > 0;
