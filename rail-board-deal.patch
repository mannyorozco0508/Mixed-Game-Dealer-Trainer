+/* ---------------- AI action round ----------------
+   Runs a simulated betting round using table-action.js for order/legality
+   and ai-players.js for the decisions. NO chip accounting: stacks are never
+   modified, no pot is tracked. Guarded by actionGeneration so stale timers
+   from an abandoned hand can never mutate a new table. */
+function cancelPendingActions(){
+  actionGeneration++;
+  pendingActionTimers.forEach(t => clearTimeout(t));
+  pendingActionTimers = [];
+}
+
+function tierFamilyForGame(game){
+  if(!game) return 'high';
+  const n = game.name;
+  // Split-pot games must be read for BOTH halves. Reading only the high side
+  // made a made low score WEAK, which folded most of the field on 3rd street.
+  if(/Hi-Lo|Hi\/Lo|8-or-Better/.test(n)) return 'stud-hilo';
+  if(n.indexOf('Razz') === 0 || n.indexOf('A-5') === 0) return 'low-a5';
+  if(n.indexOf('2-7') === 0) return 'low-27';
+  if(n === 'Badugi') return 'badugi';
+  if(n.indexOf('Big O') === 0 || n.indexOf('Drawmaha') === 0 || n.indexOf('Double Board') === 0) return 'omaha';
+  return 'high';
+}
+
+// Cards a seat currently holds, honouring discards via the slot map.
+/* Door/up cards for a street, derived from the CARD MODEL rather than from
+   rendered state. The bring-in must be known the instant the cards leave the
+   deck — long before any animation timer has fired — so this deliberately
+   does NOT go through heldCards()/seatSlotMaps, which describe what has been
+   pitched to the table so far. Card identity and order are read, never
+   written. */
+function upCardsFromModel(game, stepIndex, seatCount, sitOutSeat){
+  const pattern = game && DEAL_PATTERNS[game.dealCat];
+  const out = {};
+  if(!pattern) return out;
+  const step = Math.min(stepIndex, pattern.hole.length - 1);
+  const faceSeq = (pattern.faceSeq && pattern.faceSeq[step]) || '';
+  for(let i = 0; i < seatCount; i++){
+    if(i === sitOutSeat) continue;
+    const held = seatHoleCards[i] || [];
+    const ups = [];
+    for(let k = 0; k < held.length; k++) if(faceSeq.charAt(k) === 'U') ups.push(held[k]);
+    out[i] = ups;
+  }
+  return out;
+}
+
+function heldCards(seat){
+  const all = seatHoleCards[seat] || [];
+  const map = seatSlotMaps[seat] || [];
+  return map.length ? map.map(s => all[s]).filter(Boolean) : all;
+}
+
+// Up-cards per seat (stud), used to determine the bring-in.
+function upCardsBySeat(){
+  const pattern = currentScenario && DEAL_PATTERNS[currentScenario.dealCat];
+  const out = {};
+  if(!pattern) return out;
+  const step = Math.min(activeStepIndex, pattern.hole.length - 1);
+  const faceSeq = (pattern.faceSeq && pattern.faceSeq[step]) || '';
+  for(let i = 0; i < tableSeats; i++){
+    if(i === sitOutSeatIndex) continue;
+    const held = heldCards(i);
+    const ups = [];
+    for(let k = 0; k < held.length; k++) if(faceSeq.charAt(k) === 'U') ups.push(held[k]);
+    out[i] = ups;
+  }
+  return out;
+}
