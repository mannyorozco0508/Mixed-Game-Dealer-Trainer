+// Draws one card from the live deck. If the deck runs dry mid-hand, the muck
+// (only genuinely discarded cards) is reshuffled back in — the documented
+// house rule. A second deck is NEVER injected, so no rank/suit identity can
+// ever exist twice at the same time.
+function drawCard(){
+  if(remainingDeck.length === 0 && muckPile.length > 0){
+    for(let i = muckPile.length - 1; i > 0; i--){
+      const j = Math.floor(Math.random() * (i + 1));
+      [muckPile[i], muckPile[j]] = [muckPile[j], muckPile[i]];
+    }
+    remainingDeck = muckPile;
+    muckPile = [];
+  }
+  return remainingDeck.length ? remainingDeck.shift() : null;
+}
+
+// Cancels every in-flight pitch and invalidates their generation.
+// Abandons in-flight pitches outright — used when the hand they belong to is
+// going away (new hand, table teardown). Bumping dealGeneration also neuters
+// any timer that has already been queued by the event loop.
+function cancelPendingDeals(){
+  dealGeneration++;
+  pendingDealTimers.forEach(t => clearTimeout(t));
+  pendingDealTimers = [];
+  pendingPitchRuns = [];   // dropped, NOT run — this hand is over
+}
+
+// Inserts a single pitched card into the DOM at the moment it lands.
+function placePitchedCard(pitch){
+  const animStyle = `--deal-dx:${pitch.dx}px; --deal-dy:${pitch.dy}px;`;
+  if(pitch.kind === 'seat'){
+    const container = seatEls[pitch.seat] && seatEls[pitch.seat].querySelector('.seat-cards');
+    if(!container) return;
+    if(pitch.faceUp){
+      container.insertAdjacentHTML('beforeend', cardHtml(pitch.card, true, 0, pitch.dx, pitch.dy));
+    } else {
+      container.insertAdjacentHTML('beforeend', `<span class="mini-card face-down" style="${animStyle}"></span>`);
+    }
+    seatVisibleCardCounts[pitch.seat] = (seatVisibleCardCounts[pitch.seat] || 0) + 1;
+    // seatSlotMaps / seatDealtCounts are NOT written here. They are committed
+    // synchronously in updateTableView when the street is dealt, so action
+    // logic never depends on whether an animation timer has fired. This
+    // function is presentation only.
+    return;
+  }
+  const el = document.getElementById(pitch.kind === 'board1' ? 'boardRow1' : 'boardRow2');
+  if(!el) return;
+  el.insertAdjacentHTML('beforeend', cardHtml(pitch.card, false, 0, pitch.dx, pitch.dy));
+  if(pitch.kind === 'board1') boardVisibleCount++;
