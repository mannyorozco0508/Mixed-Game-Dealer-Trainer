+<script>
+/* ---------------- Scenario Generators ---------------- */
+/* The canonical game roster and its scenario generators now live in
+   game-data.js. That module is the single source of truth for which games
+   exist; nothing here re-declares them. */
+const { DATA, tripleDrawSteps, drawmahaCommonSteps, drawmahaScenario,
+        superStudSteps, sevenStudSteps } = window.RailGameData;
+
+const potClass = { split:"split", qual:"qual" };
+const catsEl = document.getElementById('categories');
+const detailEl = document.getElementById('detail');
+let activeCard = null;
