+    if(!wagerEl && wager > 0){
+      wagerEl = document.createElement('div');
+      wagerEl.className = 'wager-chips';
+      el.appendChild(wagerEl);
+    }
+    if(wagerEl){
+      wagerEl.innerHTML = (wager > 0 && window.RailChips)
+        ? window.RailChips.renderWager(wager) : '';
+    }
+  }
