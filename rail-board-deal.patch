+// --- Dealer Box additions (all additive, none of the above is touched) ---
+let seatChips = [];           // cosmetic-only chip stack per seat, presentation data
+let seatEls = [];             // persistent seat-pos DOM node per seat, built once per hand
+let dealerBuiltForHand = false;
+let prevHoleCount = 0, prevUpCount = 0, prevBoardCount = 0, prevBoard2Count = 0;
+let burnPileCount = 0;
+// --- Progressive dealing state ---
+// seatHoleCards holds the LOGICAL hand (complete the moment the deck is cut).
+// seatVisibleCardCounts tracks how many of those cards have actually been
+// pitched and rendered so far. The DOM only ever contains cards that have
+// genuinely landed — nothing is pre-rendered and faded in.
+let seatVisibleCardCounts = [];
+// Which physical card indices (into seatHoleCards) each seat currently holds,
+// in physical order. Discards filter this map rather than truncating the hand,
+// so Super Stud can drop two DOWN cards while keeping the face-up fifth card.
+let seatSlotMaps = [];
+// How many physical cards have actually been pitched to each seat. This is
+// NOT the same as how many are held: Super Stud pitches 9 cards over the hand
+// but retains 7 after discarding 2. Slicing by held-count would re-deal
+// already-dealt positions.
+let seatDealtCounts = [];
+let boardVisibleCount = 0;
+let board2VisibleCount = 0;
+// Bumped on every new hand / exit. Pending deal timers check this before
