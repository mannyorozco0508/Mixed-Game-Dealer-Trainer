+  }
+  if(pattern.board2 && board2Delta > 0){
+    tableBoard2Cards.slice(prevBoard2Count, targetBoard2).forEach(c => {
+      pitchQueue.push({ kind:'board2', card:c, dx:0, dy: dealerPxY - (tableH * 0.62) });
+    });
+  }
+
+  // AUTHORITATIVE STATE IS COMMITTED HERE, SYNCHRONOUSLY.
+  // seatSlotMaps and seatDealtCounts describe the physical deal, and the
+  // action system reads them through heldCards(). They used to be written
+  // inside the pitch callbacks below, which meant they only became correct
+  // once the animation finished — so startActionRound(), called on the line
+  // after renderStep(), could pick an actor and score AI hands from a
+  // truncated hand. Committing them now, in queue order, makes the model
+  // complete the moment the street is dealt. The pitch callbacks below are
+  // presentation only. Deliberately after the pitchQueue is fully built,
+  // since that loop reads these same counters to work out each slot index.
+  pitchQueue.forEach(pitch => {
+    if(pitch.kind !== 'seat') return;
+    if(!seatSlotMaps[pitch.seat]) seatSlotMaps[pitch.seat] = [];
+    seatSlotMaps[pitch.seat].push(pitch.slotIndex);
+    seatDealtCounts[pitch.seat] = Math.max(seatDealtCounts[pitch.seat] || 0, pitch.slotIndex + 1);
+  });
