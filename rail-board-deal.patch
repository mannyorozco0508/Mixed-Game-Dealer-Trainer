+  const container = el.querySelector('.seat-cards');
+  if(container) container.innerHTML = ''; // cards muck
+}
+function showSeatAction(seat, action, amount, wasAllIn){
+  const el = seatEls[seat];
+  if(!el) return;
+  let badge = el.querySelector('.action-badge');
+  if(!badge){
+    badge = document.createElement('div');
+    badge.className = 'action-badge';
+    el.appendChild(badge);
+  }
