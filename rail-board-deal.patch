+  // Board cards go out after the player cards, in board order.
+  if(boardDelta > 0){
+    tableBoardCards.slice(prevBoardCount, targetBoard).forEach(c => {
+      pitchQueue.push({ kind:'board1', card:c, dx:0, dy: dealerPxY - (tableH * 0.38) });
