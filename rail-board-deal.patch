+}
+
+// Removes any stale human controls so betting buttons never linger during
+// a draw, a coach explanation, showdown, or spectator mode.
+// Shows the human's status when they can no longer bet, so the app never
+// looks stuck. Coach keeps narrating either way.
+function showSpectatorPanel(kind){
+  const qa = document.getElementById('qaColumn');
+  if(!qa || !inPlayerMode()) return;
+  const coach = window.RailPlayer.dealerCoach(playerSession, coachState());
+  const isFold = kind === 'folded';
