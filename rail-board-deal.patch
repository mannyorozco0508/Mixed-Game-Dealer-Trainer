+DATA.forEach(cat => {
+  const block = document.createElement('div');
+  block.className = 'category-block';
+
+  const head = document.createElement('div');
+  head.className = 'category-head';
+  head.innerHTML = `
+    <span class="category-tag">${cat.tag}</span>
+    <span class="category-name">${cat.tag}</span>
+    <span class="category-desc">${cat.desc}</span>
+  `;
+  block.appendChild(head);
+
+  const rack = document.createElement('div');
+  rack.className = 'card-rack';
+
+  cat.games.forEach(game => {
+    const card = document.createElement('button');
+    card.className = 'game-card';
+    card.innerHTML = `
+      <span class="dealer-button">D</span>
+      <div class="card-pot ${potClass[game.pot] || ''}">${game.pot}</div>
+      <div class="card-title">${game.name}</div>
+      <div class="card-hint">${game.meta}</div>
+    `;
+    card.addEventListener('click', () => selectGame(card, game, cat.tag));
+    rack.appendChild(card);
+  });
+
+  block.appendChild(rack);
+  catsEl.appendChild(block);
+});
+
+/* The footer count is DERIVED from DATA rather than typed in, so the roster
+   can never drift away from what the product actually spreads. General Floor
+   Rules is a reference card, not a poker game, so it is excluded — it has no
+   dealCat and no showdown rule. */
+function pokerGameCount(){
+  let n = 0;
+  DATA.forEach(cat => cat.games.forEach(g => { if(g.dealCat) n++; }));
+  return n;
+}
+(function renderFooterCount(){
+  const f = document.getElementById('railFooter');
+  if(!f) return;
+  f.textContent = 'THE RAIL — ' + pokerGameCount() +
+    ' GAMES · REAL 7-HANDED TABLES · HOLE CARDS HIDDEN LIKE THE REAL FLOOR';
+})();
+
+/* ---------------- Local Progress Tracking ---------------- */
+function getStats(){
+  try{ return JSON.parse(localStorage.getItem('railStats') || '{}'); }
+  catch(e){ return {}; }
+}
+function saveStats(stats){
+  try{ localStorage.setItem('railStats', JSON.stringify(stats)); }
+  catch(e){ /* storage unavailable — fail silently, progress just won't persist */ }
+}
+function recordAttempt(gameName, score, total){
+  const stats = getStats();
+  const prev = stats[gameName] || { best:0, attempts:0 };
+  stats[gameName] = {
+    best: Math.max(prev.best, score),
+    attempts: prev.attempts + 1,
+    lastScore: score,
+    total: total,
+    lastPlayed: Date.now()
+  };
+  saveStats(stats);
+}
+
+function selectGame(card, game, catTag){
+  if(activeCard) activeCard.classList.remove('active');
+  card.classList.add('active');
