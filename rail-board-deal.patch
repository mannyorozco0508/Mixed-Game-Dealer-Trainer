+    // Shape by stable per-seat personality and street, never illegally.
+    if(window.RailRhythm){
+      const liveSeats = [];
+      for(let i = 0; i < tableSeats; i++){
+        if(i !== sitOutSeatIndex && !foldedSeats.has(i)) liveSeats.push(i);
+      }
+      const potNow = moneyState
+        ? moneyState.pot + moneyState.seats.reduce((n,s) => n + moneyState.streetContrib[s], 0) : 0;
+      action = window.RailRhythm.shapeAction(action, {
+        seat,
+        legal: window.RailAction.legalActions(currentRound),
+        tier,
+        phase: window.RailRhythm.streetPhase(activeStepIndex, currentScenario.scenario.length),
+        personality: window.RailRhythm.personalityFor(seat),
+        // Price context: what a call costs relative to what is out there.
+        toCall: (moneyState && window.RailMoney) ? window.RailMoney.callAmount(moneyState, seat) : 0,
+        potSize: potNow,
+        invested: moneyState ? moneyState.handContrib[seat] : 0,
+        stack: moneyState ? moneyState.stacks[seat] : 0,
+        playersLeft: liveSeats.length
+      });
+    }
+    currentRound = window.RailAction.applyAction(currentRound, seat, action);
+    // Apply REAL money for this action before rendering it.
+    let amount = 0, wasAllIn = false;
+    if(window.RailMoney && moneyState && moneyState.stacks[seat] !== undefined){
+      amount = window.RailMoney.applyMoneyAction(moneyState, seat, action, activeStepIndex);
+      wasAllIn = moneyState.allIn[seat];
+    }
+    if(action === 'fold'){
+      foldedSeats.add(seat);
+      markSeatFolded(seat);
+    }
+    showSeatAction(seat, action, amount, wasAllIn);
+    refreshMoneyUI();
+    runNextAction();
+  }, delay));
+}
+
+// Stable per-seat style variation so players don't all behave identically.
+// The AI engine has no personality support, so this is a light adapter-level
+// nudge only — it never overrides a strong-hand or fold decision.
+function seatLoosenessFor(seat){
+  return ((seat * 37) % 100) / 100;
+}
+
+// Attempts to inject a training fault. Returns the detection task if one
+// fired, otherwise null. Frequency and enablement come from config, never
+// from scattered probabilities.
+function maybeInjectFault(){
+  if(!window.RailErrors || !window.RailTasks) return null;
+  if(activeFault) return null;
+  // Frequency and permitted types come from the MODE, not a global constant.
+  const cfg = window.RailModes
+    ? window.RailModes.errorConfigForMode(currentMode, window.RailErrors.errorTypeNames())
+    : window.RailErrors.ERROR_TRAINING_CONFIG;
+  const fault = window.RailErrors.chooseError(faultContext(), cfg);
+  if(!fault) return null;
+  presentFault(fault);
+  return window.RailErrors.detectionTaskFor(fault);
+}
