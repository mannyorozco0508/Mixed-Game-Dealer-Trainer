+// Live state for the coach — read only, never a scripted transcript.
+function coachState(){
+  const layers = (moneyState && window.RailMoney)
+    ? window.RailMoney.potLayers(moneyState, foldedSeats) : [];
+  return {
+    currentActor: currentRound ? currentRound.current : null,
+    roundComplete: !!(currentRound && currentRound.complete),
+    hasNextStreet: !!(currentScenario && activeStepIndex < currentScenario.scenario.length - 1),
+    allInSeats: moneyState ? moneyState.seats.filter(s => moneyState.allIn[s]) : [],
+    foldedSeats: Array.from(foldedSeats),
+    sidePotCount: layers.length,
+    bringInSeat: currentBringInSeat,
+    street: activeStepIndex,
+    showdown: false
+  };
+}
+
+/* ---------------- Startup verification ----------------
+   Runs before anything else. If a module is missing or stale the app says so
+   in plain language and refuses to start a hand, rather than failing halfway
+   through with an error a dealer cannot interpret. */
+let bootReport = null;
+let bootOk = false;
+
+function runBootCheck(){
+  if(!window.RailBoot){
+    // boot-check.js itself is missing — report that directly.
+    bootOk = false;
+    showBootFailure({
+      ok:false,
+      summary:'The startup check could not run.',
+      failures:[{ filename:'boot-check.js', role:'Startup verification',
+        detail:'boot-check.js did not load. The file is missing from the repository, or its name does not match exactly.' }]
+    }, ['boot-check.js']);
+    return false;
+  }
+  bootReport = window.RailBoot.verifyBoot(window);
+  bootOk = bootReport.ok;
+  if(!bootOk) showBootFailure(bootReport, window.RailBoot.filesToFix(bootReport));
+  return bootOk;
+}
+
+function showBootFailure(report, files){
+  const overlay = document.getElementById('boot-overlay');
+  if(!overlay) return;
+  document.getElementById('bootSummary').textContent =
+    report.summary + ' Practice Mode is unavailable until this is fixed.';
+
+  const filesEl = document.getElementById('bootFiles');
+  filesEl.innerHTML = (files || []).map(f =>
+    '<div class="boot-file">' + f + '</div>').join('') || '<div class="boot-file">(unknown)</div>';
+
+  const detailsEl = document.getElementById('bootDetails');
+  detailsEl.innerHTML = (report.failures || []).map(f =>
+    '<div class="boot-detail-item"><span class="boot-detail-name">' + f.filename + '</span>' +
+    (f.role ? ' — ' + f.role : '') + '<br>' + f.detail + '</div>').join('');
+
+  overlay.classList.add('open');
+  document.body.style.overflow = 'hidden';
+}
+
+// Guard: Practice Mode cannot start on a broken install.
+function guardBoot(){
+  if(bootOk) return true;
+  const overlay = document.getElementById('boot-overlay');
+  if(overlay) overlay.classList.add('open');
+  return false;
+}
