+    { action: window.RailAction, money: window.RailMoney });
+
+  const coach = window.RailPlayer.dealerCoach(playerSession, coachState());
+  const help = window.RailPlayer.playerHelp(playerSession, {
+    dealCat: currentScenario && currentScenario.dealCat,
+    gameName: currentScenario && currentScenario.name,
+    phase: 'action'
+  });
+
+  qa.innerHTML = `
+    <div class="player-panel">
+      <div class="player-turn">YOUR ACTION</div>
+      ${help ? '<div class="player-help">' + help + '</div>' : ''}
