+    // fewer than five cards existed, which made the whole table check until
+    // the last street.
+    const tier = window.RailRhythm
+      ? window.RailRhythm.tierForStreet({
+          cards: held, board, family,
+          fullTier: () => window.RailAction.tierForSeat(held, board, family)
+        })
+      : window.RailAction.tierForSeat(held, board, family);
