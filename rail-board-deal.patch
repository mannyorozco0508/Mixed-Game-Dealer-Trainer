+    if(foldedSeats.has(i)) continue;
+    const held = seatHoleCards[i] || [];
+    const pattern = DEAL_PATTERNS[currentScenario.dealCat];
+    const finalCount = pattern ? pattern.hole[pattern.hole.length - 1] : held.length;
+    // Use the slot map so discarded physical cards are genuinely excluded from
+    // evaluation rather than silently reappearing via a positional slice.
+    const slotMap = seatSlotMaps[i] || [];
+    const cards = slotMap.length
+      ? slotMap.map(s => held[s]).filter(Boolean)
+      : held.slice(0, finalCount);
+    if(cards.length > 0) players.push({ seat:i, cards });
+  }
+  return window.RailShowdown.evaluateShowdown({
+    game: currentScenario,
+    players,
+    board: showdownBoard,
+    board2: showdownBoard2
+  });
+}
+
+function renderShowdown(){
+  progressFill.style.width = '100%';
+  cancelPendingActions(); // no AI action underneath the showdown
+
+  // If folds left only one player, there is no showdown to run.
+  const stillIn = [];
+  for(let i = 0; i < tableSeats; i++){
+    if(i !== sitOutSeatIndex && !foldedSeats.has(i)) stillIn.push(i);
+  }
+  if(stillIn.length <= 1){
+    handEndedByFolds = true;
+    const winner = stillIn.length ? stillIn[0] : null;
+    showdownResult = null;
+    let wonAmount = 0;
+    if(window.RailMoney && moneyState && winner !== null){
+      wonAmount = window.RailMoney.awardToSinglePlayer(moneyState, winner);
+      refreshMoneyUI();
+    }
+    const hud = document.getElementById('dealerHud');
+    if(hud) hud.innerHTML = `<span class="hud-game">${currentScenario.name}</span><span class="hud-sep">\u00b7</span><span class="hud-task">Hand Complete</span>`;
+    showDealerCue('Push Pot');
+    if(winner !== null && seatEls[winner]) seatEls[winner].classList.add('showdown-winner');
+    const qa = document.getElementById('qaColumn');
+    qa.innerHTML = `
+      <div class="showdown-panel">
+        <div class="showdown-title">${winner !== null ? 'POT AWARDED \u2014 PLAYER ' + (winner+1) : 'HAND COMPLETE'}</div>
+        <div class="showdown-note">All other players folded, so there is no showdown. The pot is pushed to the last player standing.${wonAmount ? ' Pot won: <strong>$' + wonAmount + '</strong>.' : ''}</div>
+        <button class="continue-hand-btn show" id="toSummaryBtn">Hand Complete</button>
+      </div>`;
+    document.getElementById('toSummaryBtn').addEventListener('click', () => renderSummary(true));
+    return;
+  }
+
+  // Any cards still mid-pitch are finished instantly — showdown must always
+  // evaluate and display a complete table regardless of animation progress.
+  flushPendingDeals();
+  showdownResult = runShowdown();
+
+  const hud = document.getElementById('dealerHud');
+  if(hud) hud.innerHTML = `<span class="hud-game">${currentScenario.name}</span><span class="hud-sep">\u00b7</span><span class="hud-task">Showdown</span>`;
+  showDealerCue('Showdown');
+
+  // Reveal every eligible player's cards face-up, and top up the board visually
+  // so what the trainee sees matches what was actually evaluated.
+  revealAllHands();
+
+  const qaColumn = document.getElementById('qaColumn');
+  if(!showdownResult || !showdownResult.ok){
+    const msg = showdownResult ? showdownResult.error : 'Showdown unavailable for this game.';
+    qaColumn.innerHTML = `
+      <div class="showdown-panel">
+        <div class="showdown-title">Showdown</div>
+        <div class="showdown-note">${msg}</div>
+        <button class="continue-hand-btn show" id="toSummaryBtn">Hand Complete</button>
+      </div>`;
+    document.getElementById('toSummaryBtn').addEventListener('click', () => renderSummary(true));
+    return;
+  }
+
+  const r = showdownResult;
+  let headline;
+  if(r.isScoop) headline = `SCOOP \u2014 PLAYER ${r.winners[0] + 1}`;
+  else if(r.hasTie && r.winners.length > 1 && r.sides.length === 1) headline = 'SPLIT \u2014 TIE';
+  else if(r.sides.length > 1) headline = 'SPLIT POT';
+  else headline = `WINNER \u2014 PLAYER ${r.winners[0] + 1}`;
+
+  const sideHtml = r.sides.map(side => {
+    if(side.winners.length === 0){
+      return `<div class="showdown-side">
+        <div class="showdown-side-label">${side.label}</div>
+        <div class="showdown-none">NO QUALIFYING ${side.label.toUpperCase().indexOf('LOW') !== -1 ? 'LOW' : 'HAND'}</div>
+      </div>`;
+    }
+    const winnerRows = side.winners.map(seat => {
+      const res = side.results.find(x => x.seat === seat);
+      return `<div class="showdown-winner-row">
+        <span class="showdown-seat">Player ${seat + 1}</span>
+        <span class="showdown-hand">${res.label}</span>
+      </div>`;
+    }).join('');
+    return `<div class="showdown-side">
+      <div class="showdown-side-label">${side.label}${side.winners.length > 1 ? ' \u2014 tie' : ''}</div>
+      ${winnerRows}
+    </div>`;
+  }).join('');
+
+  qaColumn.innerHTML = `
+    <div class="showdown-panel">
+      <div class="showdown-title">${headline}</div>
+      ${sideHtml}
+      <button class="continue-hand-btn show" id="toSummaryBtn">Push Pot \u2014 Hand Complete</button>
+    </div>`;
+
+  // --- REAL PAYOUT ---
+  // Each pot layer is judged only among the players who funded it, so a
+  // short all-in can win the main pot without touching a side pot.
+  if(window.RailMoney && moneyState && r.family === 'doubleboard'){
+    // CONFIRMED house rule: HIGH ONLY on both boards, layer splits
+    // top/bottom, odd board chip to the TOP board. Deliberately NOT the
+    // hi/lo splitter — there is no low side in this game.
+    const topSide = r.sides.find(s => s.key === 'board1');
+    const bottomSide = r.sides.find(s => s.key === 'board2');
+    lastPayout = window.RailMoney.awardDoubleBoardPots(moneyState, foldedSeats, eligible => ({
+      topWinners: topSide ? topSide.winners.filter(s => eligible.indexOf(s) !== -1) : [],
+      bottomWinners: bottomSide ? bottomSide.winners.filter(s => eligible.indexOf(s) !== -1) : []
+    }));
+    refreshMoneyUI();
+  } else if(window.RailMoney && moneyState){
+    const payoutInfo = window.RailMoney.awardPots(moneyState, foldedSeats, eligible => {
+      const highSide = r.sides.find(s => s.key === 'high' || s.key === 'omaha' || s.key === 'badugi' || s.key === 'board1');
+      const lowSide  = r.sides.find(s => s.key === 'low' || s.key === 'points' || s.key === 'draw' || s.key === 'board2');
+      return {
+        highWinners: highSide ? highSide.winners.filter(s => eligible.indexOf(s) !== -1) : [],
+        lowWinners:  lowSide  ? lowSide.winners.filter(s => eligible.indexOf(s) !== -1)  : []
+      };
+    });
+    lastPayout = payoutInfo;
+    refreshMoneyUI();
+  }
+
+  // Stage the result rather than dropping it all at once, so a trainee can
+  // follow WHY the pot divided the way it did. Every figure shown comes from
+  // the payout result the engine already produced.
+  runShowdownStages(r);
+}
+
+/* Runs the staged showdown. Each stage renders, waits a short mode-aware
+   beat, then advances. Nothing here computes a result — it reads what
+   showdown.js and money-state.js already decided. */
+let showdownPresentation = null;
+
+function runShowdownStages(result){
+  if(!window.RailShowPresent){ finishShowdown(result); return; }
+  const SPn = window.RailShowPresent;
+  showdownPresentation = SPn.createPresentation({
+    mode: currentMode, generation: dealGeneration
+  });
+  const generation = dealGeneration;
+  const layers = lastPayout ? SPn.layerBreakdown(lastPayout) : [];
+  const sides = SPn.sideSummaries(result);
+  const humanSeat = inPlayerMode() ? playerSession.humanSeat : undefined;
+
+  const step = () => {
+    if(generation !== dealGeneration) return;      // hand abandoned
+    renderShowdownStage(result, layers, sides, humanSeat);
+    if(SPn.isComplete(showdownPresentation)) return;
+    const delay = SPn.stageDelay(currentMode, showdownPresentation.stage);
+    pendingActionTimers.push(setTimeout(() => {
+      if(generation !== dealGeneration) return;
+      SPn.nextStage(showdownPresentation);
+      step();
+    }, delay));
+  };
+  step();
+}
+
+function renderShowdownStage(result, layers, sides, humanSeat){
+  const SPn = window.RailShowPresent;
+  const qa = document.getElementById('qaColumn');
+  if(!qa || !showdownPresentation) return;
+  const stage = showdownPresentation.stage;
+  const detail = SPn.detailLevel(currentMode);
+  const showCoach = SPn.showCoachAtShowdown(currentMode);
+
+  let body = '';
+
+  // Hands are read from the reveal stage onward.
+  if(stage !== SPn.STAGE.SHOWDOWN){
+    const lines = SPn.handLines(result, { humanSeat });
+    const bySeat = {};
+    lines.forEach(l => {
+      bySeat[l.seat] = bySeat[l.seat] || { seat:l.seat, isYou:l.isYou, parts:[] };
+      bySeat[l.seat].parts.push({ side:l.sideLabel, label:l.label, win:l.isWinner });
+    });
+    body += '<div class="sd-hands">' + Object.keys(bySeat).map(k => {
+      const h = bySeat[k];
+      const who = h.isYou ? 'YOU' : 'Player ' + (+k + 1);
+      const parts = h.parts.map(p =>
+        '<div class="sd-hand-line' + (p.win ? ' win' : '') + '">' +
+        (sides.length > 1 ? '<span class="sd-side">' + p.side + '</span>' : '') +
+        '<span class="sd-made">' + p.label + '</span></div>').join('');
+      return '<div class="sd-player"><span class="sd-who">' + who + '</span>' + parts + '</div>';
+    }).join('') + '</div>';
+  }
+
+  // Light up exactly the cards that play, per side, from evaluator data.
+  if(window.RailHighlight && (stage === SPn.STAGE.READ || stage === SPn.STAGE.LAYERS ||
+     stage === SPn.STAGE.PAYOUT || stage === SPn.STAGE.COMPLETE)){
+    applyWinningHighlights(result);
+  }
+
+  // Side outcomes appear once hands have been read.
+  if(stage === SPn.STAGE.READ || stage === SPn.STAGE.LAYERS ||
+     stage === SPn.STAGE.PAYOUT || stage === SPn.STAGE.COMPLETE){
+    body += '<div class="sd-sides">' + sides.map(s =>
+      '<div class="sd-side-row' + (s.qualified ? '' : ' unqualified') + '">' +
+      '<span class="sd-side-label">' + s.label + '</span>' +
+      '<span class="sd-side-text">' + s.text + '</span></div>').join('') + '</div>';
+  }
+
+  // Pot layers, each with its own eligibility.
+  if((stage === SPn.STAGE.LAYERS || stage === SPn.STAGE.PAYOUT ||
+      stage === SPn.STAGE.COMPLETE) && layers.length){
+    body += '<div class="sd-layers">' + layers.map(l => {
+      let inner = '<div class="sd-layer-head">' + l.name + ' $' + l.amount + '</div>';
+      if(detail !== 'minimal'){
+        inner += '<div class="sd-elig">Eligible: ' + l.eligibleText + '</div>';
+      }
+      if(l.boards){
+        inner += l.boards.map(b =>
+          '<div class="sd-board">' + b.name + ' $' + b.share +
+          (b.winnerText ? ' \u2192 ' + b.winnerText : '') + '</div>').join('');
+        if(l.oddChipNote && detail !== 'minimal'){
+          inner += '<div class="sd-note">' + l.oddChipNote + '</div>';
+        }
+      }
+      return '<div class="sd-layer">' + inner + '</div>';
+    }).join('') + '</div>';
+  }
+
+  // Actual chips paid.
+  if(stage === SPn.STAGE.PAYOUT || stage === SPn.STAGE.COMPLETE){
+    const pay = lastPayout ? SPn.payoutLines(lastPayout, { humanSeat }) : [];
+    if(pay.length){
+      body += '<div class="sd-payouts">' + pay.map(p =>
+        '<div class="sd-payout' + (p.isYou ? ' you' : '') + '">' + p.text + '</div>').join('') + '</div>';
+    }
+    result.winners.forEach(seat => {
+      if(seatEls[seat]) seatEls[seat].classList.add('showdown-winner');
+    });
+  }
+
+  const coach = showCoach ? SPn.coachForStage(stage, { sides, layers }) : '';
+  const human = (humanSeat !== undefined)
+    ? SPn.humanOutcome(result, humanSeat, playerSession.folded) : null;
+
+  qa.innerHTML = `
+    <div class="showdown-panel">
+      <div class="showdown-title">${SPn.outcomeHeadline(result) || 'SHOWDOWN'}</div>
+      ${human && human.text ? '<div class="sd-you ' + (human.won ? 'won' : '') + '">' + human.text + '</div>' : ''}
+      ${body}
+      ${coach ? '<div class="dealer-coach"><span class="coach-tag">DEALER COACH</span>' + coach + '</div>' : ''}
+      ${SPn.isComplete(showdownPresentation)
+        ? '<button class="continue-hand-btn show" id="toSummaryBtn">Push Pot \u2014 Hand Complete</button>'
+        : '<button class="sd-skip" id="sdSkip">Show Result</button>'}
+    </div>`;
+
+  const skip = document.getElementById('sdSkip');
+  if(skip) skip.addEventListener('click', () => {
+    SPn.skipToEnd(showdownPresentation);
+    renderShowdownStage(result, layers, sides, humanSeat);
+  });
+  const done = document.getElementById('toSummaryBtn');
+  if(done) done.addEventListener('click', () => {
+    showDealerCue('Push Pot');
+    renderSummary(true);
+  });
+}
+
+// Marks the cards that actually play. Presentation only — card identity,
+// face state and hand contents are untouched.
+function applyWinningHighlights(result){
+  clearWinningHighlights();
+  const H = window.RailHighlight;
+  if(!H || !result || !result.ok) return;
+  const isOmaha = /Big O|Drawmaha|Double Board/.test(currentScenario.name);
+
+  result.sides.forEach(side => {
+    if(!H.shouldHighlight(side)) return;   // never light an unqualified low
+    side.winners.forEach(seat => {
+      const slotMap = seatSlotMaps[seat] || [];
+      const hole = slotMap.length
+        ? slotMap.map(s => (seatHoleCards[seat] || [])[s]).filter(Boolean)
+        : (seatHoleCards[seat] || []);
+      const hl = H.highlightFor(side, seat, {
+        hole, board: showdownBoard.length ? showdownBoard : tableBoardCards,
+        board2: showdownBoard2
+      });
+      const el = seatEls[seat];
+      const container = el && el.querySelector('.seat-cards');
+      if(container){
+        hl.holeSlots.forEach(i => {
+          const cardEl = container.children[i];
+          if(cardEl) cardEl.classList.add('card-playing');
+        });
+      }
+      const b1 = document.getElementById('boardRow1');
+      if(b1) hl.boardSlots.forEach(i => {
+        if(b1.children[i]) b1.children[i].classList.add('card-playing');
+      });
+      const b2 = document.getElementById('boardRow2');
+      if(b2) hl.board2Slots.forEach(i => {
+        if(b2.children[i]) b2.children[i].classList.add('card-playing');
+      });
+    });
+  });
+}
+
+function clearWinningHighlights(){
+  document.querySelectorAll('.card-playing').forEach(el => el.classList.remove('card-playing'));
+}
+
+function finishShowdown(result){
+  const qa = document.getElementById('qaColumn');
+  if(!qa) return;
+  qa.innerHTML = '<div class="showdown-panel"><div class="showdown-title">Showdown</div>' +
+    '<button class="continue-hand-btn show" id="toSummaryBtn">Hand Complete</button></div>';
+  document.getElementById('toSummaryBtn').addEventListener('click', () => renderSummary(true));
+}
+
+// Turns every eligible player's cards face-up and syncs the board to what was
+// actually evaluated. Card identity is never altered — only presentation.
+function revealAllHands(){
+  const pattern = currentScenario && DEAL_PATTERNS[currentScenario.dealCat];
+  if(!pattern) return;
+  const finalCount = pattern.hole[pattern.hole.length - 1];
+  for(let i = 0; i < tableSeats; i++){
+    if(i === sitOutSeatIndex) continue;
+    if(foldedSeats.has(i)) continue; // mucked hands are never revealed
+    const container = seatEls[i] && seatEls[i].querySelector('.seat-cards');
+    if(!container) continue;
+    // Reveal exactly the cards the seat actually RETAINS — using the slot map
+    // rather than slicing, so discarded positions aren't wrongly resurrected.
+    const slotMap = seatSlotMaps[i] || [];
+    const held = slotMap.length
+      ? slotMap.map(s => (seatHoleCards[i] || [])[s]).filter(Boolean)
+      : (seatHoleCards[i] || []).slice(0, finalCount);
+    container.innerHTML = held.map(c => cardHtml(c, true)).join('');
+    seatVisibleCardCounts[i] = held.length;
+  }
+  const board1El = document.getElementById('boardRow1');
+  if(board1El && showdownBoard.length){
+    board1El.innerHTML = showdownBoard.map(c => cardHtml(c, false)).join('');
+  }
+  const board2El = document.getElementById('boardRow2');
+  if(board2El && showdownBoard2.length){
+    board2El.innerHTML = showdownBoard2.map(c => cardHtml(c, false)).join('');
+    board2El.style.display = 'flex';
+    // Two boards must be unmistakably separate — label them.
+    const l1 = document.getElementById('boardLabel1');
+    const l2 = document.getElementById('boardLabel2');
+    if(l1) l1.textContent = 'TOP BOARD';
+    if(l2) l2.textContent = 'BOTTOM BOARD';
+  }
+}
+
+function renderStepContent(step, tableIndex, isLastOfRun){
+  // shuffle option order each render
+  const opts = step.options.map((o, i) => ({...o, origIndex:i}))
+    .sort(() => Math.random() - 0.5);
+
+  const qaColumn = document.getElementById('qaColumn');
+  qaColumn.innerHTML = `
+    ${reviewMode ? '<div class="review-tag">Reviewing a missed street</div>' : ''}
+    <div class="scenario-prompt">${step.prompt}</div>
+    <div class="option-list" id="optionList"></div>
+    <div class="feedback-box" id="feedbackBox">
+      <span class="feedback-label" id="feedbackLabel"></span>
+      <span id="feedbackText"></span>
+    </div>
+    <button class="continue-hand-btn" id="continueHandBtn">${isLastOfRun ? (reviewMode ? 'Back to Results' : 'See Results') : 'Continue Hand'}</button>
+  `;
+  cancelPendingActions(); // freeze the table while the trainee decides
+  updateTableView(tableIndex);
+  updateDealerHud(step);
+  updateStreetIndicator(tableIndex);
+  showDealerCue(step.street);
+  activeStepIndex = tableIndex;
+
+  const optionList = document.getElementById('optionList');
+  taskAnswered = false;
+  clearTaskInteraction();
+
+  // Dynamic tasks lock a state snapshot the moment they open, so a late AI
+  // callback cannot change the correct answer while the trainee is thinking.
+  const taskType = window.RailTasks ? window.RailTasks.typeOf(step) : 'multiple-choice';
+  if(window.RailTasks && window.RailTasks.isDynamic(step)){
+    activeTaskSnapshot = currentSimSnapshot();
+    if(taskType === 'select-seat') renderSelectSeatTask(step, optionList);
+    else if(taskType === 'select-seats') renderSelectSeatsTask(step, optionList);
+    else if(taskType === 'numeric-amount') renderNumericTask(step, optionList);
+  } else {
+    activeTaskSnapshot = null;
+    opts.forEach(opt => {
+      const btn = document.createElement('button');
+      btn.className = 'option-btn';
+      btn.textContent = opt.text;
+      btn.addEventListener('click', () => handleAnswer(opt, optionList));
+      optionList.appendChild(btn);
+    });
+  }
+
+  scenarioBody.scrollTop = 0;
+}
+
+/* ---------------- Play & Learn: card decisions ----------------
+   One selection flow for every game that asks the player to release cards.
+   The rule decides how many and which slots are eligible; the UI only
+   collects taps. Nothing is submitted unless the rule says it is legal. */
+let cardChoiceSession = null;
+
+// Returns true if a human card decision is required right now.
+function needsCardChoice(){
+  if(!inPlayerMode() || playerSession.folded) return false;
+  if(!currentScenario) return false;
+  // A fixed discard rule (Pineapple, Super Stud) ...
+  if(window.RailCardChoice &&
+     window.RailCardChoice.hasChoiceAt(currentScenario.dealCat, activeStepIndex)) return true;
+  // ... or a real draw round.
+  return isDrawStep();
+}
+
+// True when the current scenario step is one of the game's real draws.
+// Derived from the step's own street label, so inserted training questions
+// never shift which steps are draws.
+function isDrawStep(){
+  if(!window.RailDraw || !currentScenario) return false;
+  if(!window.RailDraw.isDrawGame(currentScenario.dealCat)) return false;
+  const step = currentScenario.scenario[activeStepIndex];
+  if(!step || !/^Draw/i.test(step.street)) return false;
+  return drawStepIndex() > 0;
+}
+
+// Which draw this is (1-based), counting only real draw streets up to here.
+function drawStepIndex(){
+  if(!currentScenario) return 0;
+  const seen = [];
+  for(let i = 0; i <= activeStepIndex; i++){
+    const s = currentScenario.scenario[i];
+    if(s && /^Draw/i.test(s.street) && seen.indexOf(s.street) === -1) seen.push(s.street);
+  }
+  const cur = currentScenario.scenario[activeStepIndex];
+  return cur ? seen.indexOf(cur.street) + 1 : 0;
+}
+
+function showCardChoice(){
+  const seat = playerSession.humanSeat;
+  // A draw round builds its rule from the draw engine; a fixed discard
+  // (Pineapple, Super Stud) uses its configured rule. Same selection UI.
+  const rule = isDrawStep()
+    ? drawRuleForChoice()
+    : window.RailCardChoice.ruleFor(currentScenario.dealCat, activeStepIndex);
+  if(!rule) return;
+
+  cancelPendingActions();   // nothing moves under the player
+  const held = (seatSlotMaps[seat] || []).length || rule.handSize;
+  cardChoiceSession = window.RailCardChoice.beginCardChoice({
+    dealCat: currentScenario.dealCat, rule, handSize: held, generation: dealGeneration
+  });
+  renderCardChoice();
+  markSelectableCards();
+}
+
+// Builds a card-choice rule for a draw: any held card may be replaced,
+// and standing pat is legal, so 0..handSize is valid.
+function drawRuleForChoice(){
+  const seat = playerSession.humanSeat;
+  const held = (seatSlotMaps[seat] || []).length ||
+    (seatHoleCards[seat] || []).length;
+  const n = drawStepIndex();
+  return {
+    mode: 'draw',
+    discardCount: null,          // any count is legal, including zero
+    handSize: held,
+    mandatoryKeep: [],
+    label: 'Draw ' + n + ' — select cards to replace',
+    helpText: window.RailDraw.drawHelp(currentScenario.dealCat, n)
+  };
+}
+
+function markSelectableCards(){
+  const seat = playerSession.humanSeat;
+  const el = seatEls[seat];
+  const container = el && el.querySelector('.seat-cards');
+  if(!container) return;
+  Array.from(container.children).forEach((cardEl, slot) => {
+    const eligible = cardChoiceSession.eligible.indexOf(slot) !== -1;
+    if(!eligible) return;
+    cardEl.classList.add('card-selectable');
+    cardEl.setAttribute('role', 'button');
+    cardEl.setAttribute('tabindex', '0');
+    cardEl.setAttribute('aria-pressed', 'false');
+    const toggle = () => {
+      if(!cardChoiceSession || cardChoiceSession.confirmed) return;
+      window.RailCardChoice.toggleSlot(cardChoiceSession, slot);
+      const on = cardChoiceSession.selected.indexOf(slot) !== -1;
+      cardEl.classList.toggle('card-selected', on);
+      cardEl.setAttribute('aria-pressed', on ? 'true' : 'false');
+      renderCardChoice();
+    };
+    cardEl._choiceHandler = toggle;
+    cardEl.addEventListener('click', toggle);
+    cardEl.addEventListener('keydown', e => {
+      if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); toggle(); }
+    });
+  });
+}
+
+function renderCardChoice(){
+  const qa = document.getElementById('qaColumn');
+  if(!qa || !cardChoiceSession) return;
+  const rule = cardChoiceSession.rule;
+  const valid = window.RailCardChoice.isValid(cardChoiceSession);
+  const help = playerSession.playerHelp ? window.RailCardChoice.choiceHelp(rule) : '';
+  const coach = playerSession.dealerCoach
+    ? window.RailCardChoice.choiceCoach(cardChoiceSession, true) : '';
+  const canPat = rule.mode === window.RailCardChoice.MODE.PAT_OR_DISCARD;
+
+  const isDraw = rule.mode === 'draw';
+  const n = cardChoiceSession.selected.length;
+  // Standing pat is an explicit choice, never "select nothing and guess".
+  const canStandPat = isDraw || canPat;
+  const drawNum = isDraw ? drawStepIndex() : 0;
+  const totalDraws = isDraw && window.RailDraw
+    ? window.RailDraw.drawRoundCount(currentScenario.dealCat) : 0;
+
+  qa.innerHTML = `
+    <div class="player-panel">
+      ${totalDraws ? '<div class="draw-counter">DRAW ' + drawNum + ' OF ' + totalDraws + '</div>' : ''}
+      <div class="player-turn">${rule.label.toUpperCase()}</div>
+      ${help ? '<div class="player-help">' + help + '</div>' : ''}
+      <div class="choice-status">${window.RailCardChoice.statusText(cardChoiceSession)}</div>
+      <div class="player-actions">
+        ${canPat ? '<button class="player-action-btn" id="choicePat">' +
+          (cardChoiceSession.pat ? 'CANCEL PAT' : rule.patLabel) + '</button>' : ''}
+        ${(isDraw && n === 0) ? '<button class="player-action-btn" id="choiceStandPat">STAND PAT</button>' : ''}
+        <button class="player-action-btn primary" id="choiceConfirm"${valid ? '' : ' disabled'}>
+          ${cardChoiceSession.pat ? 'CONFIRM PAT'
+            : (isDraw ? (n === 0 ? 'CONFIRM' : 'CONFIRM DRAW ' + n) : 'CONFIRM DISCARD')}
+        </button>
+      </div>
+      ${coach ? '<div class="dealer-coach"><span class="coach-tag">DEALER COACH</span>' + coach + '</div>' : ''}
+    </div>`;
+
+  const standPatBtn = document.getElementById('choiceStandPat');
+  if(standPatBtn) standPatBtn.addEventListener('click', confirmCardChoice);
+
+  const patBtn = document.getElementById('choicePat');
+  if(patBtn) patBtn.addEventListener('click', () => {
+    window.RailCardChoice.declarePat(cardChoiceSession, !cardChoiceSession.pat);
+    clearCardSelectionVisuals();
+    renderCardChoice();
+  });
+  const confirmBtn = document.getElementById('choiceConfirm');
+  if(confirmBtn) confirmBtn.addEventListener('click', confirmCardChoice);
+}
+
+function confirmCardChoice(){
+  if(!cardChoiceSession) return;
+  const result = window.RailCardChoice.confirmChoice(cardChoiceSession, dealGeneration);
+  if(!result) return;   // stale or invalid — never mutates the hand
+
+  const seat = playerSession.humanSeat;
+
+  if(isDrawStep()){
+    // A DRAW: perform the real mutation. Selected cards leave the hand,
+    // enter the muck, and exactly that many replacements come off the live
+    // deck via the same drawCard() the dealing engine already uses.
+    const slotMap = seatSlotMaps[seat] || [];
+    const held = slotMap.length
+      ? slotMap.map(s => (seatHoleCards[seat] || [])[s]).filter(Boolean)
+      : (seatHoleCards[seat] || []).slice();
+    const r = window.RailDraw.applyDraw(held, cardChoiceSession.selected, drawCard, muckPile);
+
+    // Write the new hand back through the slot model so rendering, showdown
+    // and card identity all stay consistent.
+    const base = seatHoleCards[seat] || [];
+    const newMap = [];
+    r.hand.forEach(card => {
+      let idx = base.indexOf(card);
+      if(idx === -1){ base.push(card); idx = base.length - 1; }
+      newMap.push(idx);
+    });
+    seatHoleCards[seat] = base;
+    seatSlotMaps[seat] = newMap;
+    lastDrawResult = r;
+    showSeatAction(seat, window.RailDraw.drawLabel(r).toLowerCase(), 0, false);
+  } else {
+    // A fixed discard rule: hand the chosen keep-slots to the dealing engine.
+    humanKeepSlots = result.keepSlots.slice();
+    humanIsPat = result.pat;
+  }
+
+  clearCardSelectionVisuals();
+  cardChoiceSession = null;
+  const qa = document.getElementById('qaColumn');
+  if(qa) qa.innerHTML = '';
+  advanceAfterCardChoice();
+}
+
+function clearCardSelectionVisuals(){
+  seatEls.forEach(el => {
+    if(!el) return;
+    const container = el.querySelector('.seat-cards');
+    if(!container) return;
+    Array.from(container.children).forEach(cardEl => {
+      cardEl.classList.remove('card-selectable', 'card-selected');
+      cardEl.removeAttribute('role');
+      cardEl.removeAttribute('tabindex');
+      cardEl.removeAttribute('aria-pressed');
+      if(cardEl._choiceHandler){
+        cardEl.removeEventListener('click', cardEl._choiceHandler);
+        cardEl._choiceHandler = null;
+      }
+    });
+  });
+}
+
+let humanKeepSlots = null;
+let humanIsPat = false;
+let lastDrawResult = null;
+
+function advanceAfterCardChoice(){
+  stepIndex++;
+  renderStep();
+  if(currentScenario && stepIndex < currentScenario.scenario.length) startActionRound();
+}
