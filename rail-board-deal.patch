+        kind: 'seat',
+        seat: i,
+        card,
+        slotIndex,
+        faceUp: faceSeq.charAt(handPos) === 'U',
+        dx: dealerPxX - (tableW * seatXPct / 100),
+        dy: dealerPxY - (tableH * seatYPct / 100)
