+      // Where this card sits in the CURRENT hand (after any earlier discard)
+      const handPos = (seatSlotMaps[i] ? seatSlotMaps[i].length : 0) + round;
+      const angle = seatAngle(i, tableSeats);
+      const rad = angle * Math.PI / 180;
+      const seatXPct = 50 + 37 * Math.cos(rad);
+      const seatYPct = 50 + 40 * Math.sin(rad);
