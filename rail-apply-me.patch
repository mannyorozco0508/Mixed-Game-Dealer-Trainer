+  });
+  check('an empty draw source deals no cards rather than undefined ones',
+        plan.pitchQueue.filter(p => p.kind === 'seat').length === 0);
+}
+
+console.log('');
+console.log('=== RESULTS: ' + pass + ' passed, ' + fail + ' failed ===');
+if(fail > 0) process.exit(1);
