+let currentScenario = null;
+let stepIndex = 0;
+let correctCount = 0;
+let missedSteps = [];
+let reviewMode = false;
+let reviewQueue = [];
+let reviewPos = 0;
+let activeStepIndex = 0;
+let tableSeats = 7; // always a full 7-handed table
+let buttonSeatIndex = null;
+let sitOutSeatIndex = null;
+let seatHoleCards = [];
+let tableBoardCards = [];
+let tableBoard2Cards = [];
